{
  "name": "mallory-tensor-autograd",
  "version": "0.1.0",
  "description": "Reverse-mode automatic differentiation over mallory-tensor-core Tensors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --test test/*.test.ts"
  },
  "dependencies": {
    "mallory-tensor-core": "0.1.0",
    "mallory-telemetry": "0.0.1"
  },
  "devDependencies": {
    "mallory-math": "^0.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/mallory-plus.git",
    "directory": "packages/tensor-autograd"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  }
}
