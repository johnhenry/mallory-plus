{
  "name": "mallory-fft",
  "version": "0.0.1",
  "description": "ComplexTensor + fft/ifft/rfft/irfft for mallory-plus (issue #40) — v2 practical ML/media compute bundle",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
