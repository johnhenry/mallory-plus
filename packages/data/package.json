{
  "name": "mallory-data",
  "version": "0.0.2",
  "description": "Async dataset pipelines for mallory-plus (issue #22) — the v2 `data` namespace: a curated Dataset facade over mallory-iteration (chunk/batch/shuffle/epochs/mapConcurrent/prefetch/fold, AbortSignal cancellation) producing Tensor batches for tensor-autograd's trainer",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --test test/*.test.ts"
  },
  "dependencies": {
    "mallory-iteration": "^0.0.0",
    "mallory-tensor-core": "0.1.0"
  },
  "devDependencies": {
    "mallory-tensor-autograd": "0.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/mallory-plus.git",
    "directory": "packages/data"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  }
}
