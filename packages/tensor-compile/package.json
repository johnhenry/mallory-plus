{
  "name": "mallory-tensor-compile",
  "version": "0.0.5",
  "description": "Elementwise expression IR + fusion for mallory-plus (issue #11) — trace once, execute fused; the shared IR target for the future WebGPU kernel DSL and the Symbolic bridge",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --test test/*.test.ts && npm run test:bench",
    "test:bench": "node --test test/*.bench-test.ts"
  },
  "dependencies": {
    "mallory-tensor-core": "0.2.0",
    "mallory-tensor-autograd": "0.2.2"
  },
  "devDependencies": {
    "mallory-math": "^0.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/mallory-plus.git",
    "directory": "packages/tensor-compile"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  }
}
