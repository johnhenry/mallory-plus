{
  "name": "mallory-mcp",
  "version": "0.0.3",
  "description": "MCP server exposing mallory-math Symbolic evaluation + guarded tensor/linalg computation as agent-callable tools (issue #45) — no arbitrary code execution, structured inputs only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mallory-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mallory-adapter-math": "0.1.1",
    "mallory-math": "^0.8.0",
    "mallory-tensor-core": "0.1.0",
    "zod": "^3.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/mallory-plus.git",
    "directory": "packages/mcp"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  }
}
