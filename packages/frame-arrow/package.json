{
  "name": "mallory-frame-arrow",
  "version": "1.0.0",
  "description": "Immutable, expression-oriented Frame/Series dataframe library on top of apache-arrow — part of Mallory Plus",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --test test/*.test.ts"
  },
  "dependencies": {
    "apache-arrow": "21.2.0"
  },
  "peerDependencies": {
    "mallory-tensor-core": "0.1.0"
  },
  "peerDependenciesMeta": {
    "mallory-tensor-core": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/mallory-plus.git",
    "directory": "packages/frame-arrow"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  }
}
