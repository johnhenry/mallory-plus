{
  "name": "mallory-plus",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "adapters/*",
    "scalars/*"
  ],
  "scripts": {
    "build:wasm": "npm run build:wasm -w mallory-tensor-wasm",
    "build": "npm run build:wasm && npm run build -w mallory-scalar-types -w mallory-tensor-core -w mallory-tensor-wasm",
    "test": "npm run test -w mallory-scalar-types -w mallory-tensor-core -w mallory-tensor-wasm",
    "check": "npm run check --workspaces --if-present",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "async-itertools": "github:johnhenry/async-itertools#ae0d558a84aa51b7119be885bf3fd3e402330158",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
